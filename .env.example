# Mishari Voice Studio — environment configuration
# Copy this file to .env and fill in values. NEVER commit .env.

# Base directory for all local data (voices, samples, generated audio, database)
DATA_DIR=./data

# SQLite database file name (lives inside DATA_DIR)
DATABASE_NAME=mishari_voice_studio.db

# --- Cloud provider: ElevenLabs ---
# Leave blank to run without cloud generation (Stage 1 default).
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# --- Local provider (Stage 1: not yet implemented) ---
LOCAL_VOICE_MODEL_DIR=

# --- Audio export preferences ---
AUDIO_EXPORT_FORMAT=wav
AUDIO_EXPORT_SAMPLE_RATE=44100
